# Skopiuj na serwer jako /opt/logoped-assist.env (chmod 600). Nie commituj wypełnionego pliku.
# Hasło Postgresa: tylko litery i cyfry (trafia do DB_URL).

POSTGRES_USER=logoped
POSTGRES_PASSWORD=wpisz_haslo_postgres
POSTGRES_DB=logoped
DB_URL=postgresql+asyncpg://logoped:wpisz_haslo_postgres@postgres:5432/logoped

VLLM_BASE_URL=https://vllm.example.com/v1
VLLM_API_KEY=wpisz-klucz-api-vllm
VLLM_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_EMBEDDING_MODEL=BAAI/bge-m3

WHISPER_API_URL=https://whisper.example.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=openai/whisper-large-v3

JWT_SECRET=wygeneruj-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@twoja-domena.pl
ADMIN_PASSWORD=wpisz-silne-haslo-admina
CORS_ORIGINS=https://logoped.twoja-domena.pl

RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_TOP_K=12
RERANK_TOP_N=4
RERANK_MIN_SCORE=0.02
