# ---- Zewnętrzny serwer vLLM (API zgodne z OpenAI) ----
VLLM_BASE_URL=https://vllm.example.com/v1
VLLM_API_KEY=wpisz-klucz-api-vllm
VLLM_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_EMBEDDING_MODEL=BAAI/bge-m3

# ---- Zewnętrzne API Whisper (pełny URL endpointu transkrypcji) ----
WHISPER_API_URL=https://whisper.example.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=openai/whisper-large-v3

# ---- PostgreSQL (używać tylko liter i cyfr w haśle) ----
POSTGRES_USER=logoped
POSTGRES_PASSWORD=zmien_to_haslo_postgres
POSTGRES_DB=logoped

# ---- Bezpieczeństwo (JWT_SECRET min. 32 znaki: openssl rand -hex 32) ----
JWT_SECRET=zmien-mnie-wygeneruj-openssl-rand-hex-32-min-32-znaki
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@logoped.local
ADMIN_PASSWORD=ZmienToHaslo123!
CORS_ORIGINS=http://localhost:8080,http://localhost:4200

# ---- RAG ----
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_TOP_K=12
RERANK_TOP_N=4
RERANK_MIN_SCORE=0.02

# ---- Frontend ----
FRONTEND_PORT=8080
