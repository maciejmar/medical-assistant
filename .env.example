# ---- Zewnętrzny serwer vLLM (API zgodne z OpenAI) ----
VLLM_BASE_URL=https://vllm.example.com/v1
VLLM_API_KEY=wpisz-klucz-api-vllm
VLLM_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_EMBEDDING_MODEL=BAAI/bge-m3

# ---- Zewnętrzne API Whisper (pełny URL endpointu transkrypcji) ----
WHISPER_API_URL=https://whisper.example.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=openai/whisper-large-v3

# ---- PostgreSQL (używać tylko liter i cyfr w haśle) ----
POSTGRES_USER=logoped
POSTGRES_PASSWORD=zmien_to_haslo_postgres
POSTGRES_DB=logoped

# ---- Bezpieczeństwo (JWT_SECRET min. 32 znaki: openssl rand -hex 32) ----
JWT_SECRET=zmien-mnie-wygeneruj-openssl-rand-hex-32-min-32-znaki
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=mateminfo@gmail.com
ADMIN_PASSWORD=ZmienToHaslo123!
CORS_ORIGINS=http://localhost:8080,http://localhost:4200

# ---- Log zapytań LLM (podgląd w panelu administratora) -----
LLM_LOG_ENABLED=true
LLM_LOG_RETENTION_DAYS=90

# ---- Powiadomienia e-mail dla pacjentów (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
APP_PUBLIC_URL=http://localhost:8080

# ---- RAG ----
# Katalog z materiałami bazy wiedzy (montowany w backendzie jako /kb)
KB_SOURCE_HOST_DIR=../laryngolog
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_TOP_K=12
RERANK_TOP_N=4
RERANK_MIN_SCORE=0.02

# ---- Frontend ----
FRONTEND_PORT=8080

# ---- Kredyty (zł) i model zastępczy ----
# Koszt = tokeny × cena modelu (USD / 1 mln tokenów, cennik w backend/src/billing.py) × kurs USD→PLN × marża.
BILLING_DEFAULT_LIMIT_PLN=20
BILLING_USD_PLN_RATE=3.70
BILLING_MARGIN=1.0
# Opcjonalnie nadpisanie cennika: {"gpt-4o-mini": [0.15, 0.60]}
BILLING_PRICES_JSON=
BILLING_TOPUP_AMOUNTS=20,50,100
# Płatności online – Stripe Checkout (BLIK, karta, Przelewy24). Puste = tylko przelew tradycyjny.
# Webhook w panelu Stripe: https://<domena>/api/payments/stripe/webhook, zdarzenia checkout.session.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tylko opis metod w aplikacji – same metody włącza/wyłącza się w panelu Stripe (Settings → Payment methods)
STRIPE_PAYMENT_METHODS=blik,card,p24
# Dane do przelewu przy doładowaniu
TOPUP_RECIPIENT=Webaby
TOPUP_BANK_ACCOUNT=
# Po wyczerpaniu kredytów czat korzysta z modelu lokalnego (OpenAI-compatible, np. Ollama).
# Puste = brak przełączania (zostaje model podstawowy, użytkownik widzi tylko ostrzeżenie).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=gemma4:12b
# Klucz API, gdy model zastępczy jest w chmurze (np. tańszy model OpenAI/Gemini przez endpoint OpenAI-compatible)
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=600
